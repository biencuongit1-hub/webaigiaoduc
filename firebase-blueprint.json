{
  "entities": {
    "Exam": {
      "title": "Exam",
      "description": "Represents an online test/exam created by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "multipleChoicePoints": { "type": "number" },
        "essayPoints": { "type": "number" },
        "teacherName": { "type": "string" },
        "accessCode": { "type": "string" },
        "status": { "type": "string" },
        "targetClass": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "subject", "durationMinutes", "totalPoints", "accessCode", "status"]
    },
    "ExamSubmission": {
      "title": "ExamSubmission",
      "description": "Student exam submission with answers and scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "studentId": { "type": "string" },
        "score": { "type": "number" },
        "multipleChoiceScore": { "type": "number" },
        "essayScore": { "type": "number" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "examId", "studentName", "studentClass", "score", "submittedAt", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User accounts for teachers and students with school, grade, class, birth year, credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "fullName": { "type": "string" },
        "grade": { "type": "string" },
        "className": { "type": "string" },
        "school": { "type": "string" },
        "birthYear": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "subject": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "role", "fullName", "school", "createdAt"]
    }
  },
  "firestore": {
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exams created by teachers and accessible to students"
    },
    "/submissions/{submissionId}": {
      "schema": "ExamSubmission",
      "description": "Student submissions and teacher essay grading results"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered accounts for teachers and students"
    }
  }
}
